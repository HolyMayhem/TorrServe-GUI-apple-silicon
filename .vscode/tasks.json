{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Swift: Build",
      "type": "shell",
      "command": "swift build",
      "group": "build",
      "problemMatcher": "$swiftc"
    },
    {
      "label": "App: Build TorrServer.app",
      "type": "shell",
      "command": "./scripts/build-app.sh",
      "group": "build",
      "problemMatcher": "$swiftc"
    },
    {
      "label": "App: Package DMG",
      "type": "shell",
      "command": "./scripts/package-dmg.sh",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
